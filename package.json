{
  "name": "teenstack",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node backend/dev.mjs",
    "dev:web": "vite --config frontend/vite.config.ts --port 5173",
    "dev:api": "node --no-warnings backend/index.mjs",
    "db:migrate": "node --no-warnings database/postgresql/migrate.mjs",
    "test": "node --no-warnings --test backend/tests/postgres_database.test.mjs backend/tests/verification.test.mjs backend/tests/platform_domains.test.mjs backend/tests/backend_completion.test.mjs",
    "build": "tsc -b frontend/tsconfig.json && vite build --config frontend/vite.config.ts",
    "start": "node --no-warnings backend/index.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "^0.6.0",
    "express": "^5.1.0",
    "lucide-react": "^0.511.0",
    "motion": "^12.12.1",
    "pg": "^8.20.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.7",
    "@types/node": "^22.15.21",
    "@types/react": "^19.1.5",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.5.0",
    "tailwindcss": "^4.1.7",
    "typescript": "~5.8.3",
    "vite": "^6.3.5"
  }
}
