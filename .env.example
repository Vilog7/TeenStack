# ==============================================================================
# TEENSTACK — SIGNZY AGE VERIFICATION & PARENTAL CONSENT ENVIRONMENT TEMPLATE
# ==============================================================================
# NEVER commit real secrets or expose any SIGNZY_* variable in Vite (VITE_*).

# Runtime environment: 'development' | 'test' | 'production'
NODE_ENV=development
PORT=3001

# PostgreSQL Database Connection:
# - Set DATABASE_URL to connect to an external/Docker/Cloud PostgreSQL 15+ instance (via `pg` Pool)
#   Example: postgresql://teenstack:teenstack_dev_pwd@127.0.0.1:5432/teenstack
# - Leave blank in local development to use the built-in persistent PostgreSQL engine (PGlite PGDATA)
DATABASE_URL=
PGSSLMODE=prefer

# Cryptography at Rest (REQUIRED in NODE_ENV=production; >= 32 characters each)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DATA_ENCRYPTION_KEY=replace_with_32_byte_hex_aes256_gcm_master_key_in_production
BLIND_INDEX_SECRET=replace_with_32_byte_hex_hmac_blind_index_secret_in_production

# Signzy Integration Mode:
# - 'sandbox_mock' : Non-production test simulation (AUTOMATICALLY BLOCKED in NODE_ENV=production)
# - 'live'         : Connects to real Signzy India Stack HTTPS APIs
SIGNZY_MODE=sandbox_mock

# Official Signzy Base URL:
# - Preproduction / Sandbox: https://api-preproduction.signzy.app
# - Production:              https://api.signzy.app
SIGNZY_BASE_URL=https://api-preproduction.signzy.app
SIGNZY_AUTH_PATH=/api/customers/login

# Signzy Server-Side Credentials (Provisioned by Signzy Account Team)
SIGNZY_USERNAME=
SIGNZY_PASSWORD=
SIGNZY_PATRON_ID=
SIGNZY_WEBHOOK_SECRET=

# Parental Authority Legal Gate:
# Keep 'false' until a legally reviewed parent-child guardianship authority check
# is contractually and technically bound in signzy_age_verification.mjs.
PARENTAL_AUTHORITY_WORKFLOW_APPROVED=false

# Compliance Admin Audit Key (RBAC access to GET /api/admin/compliance/audit-logs)
COMPLIANCE_ADMIN_KEY=
